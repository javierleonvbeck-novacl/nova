#!/bin/bash

if [ -z "$1" ]; then
    echo "Usage: nv-modules <local_file.c | github_raw_url>"
    exit 1
fi

INPUT="$1"

if [ ! -d "modules" ]; then
    echo "Error: 'modules' directory not found. Please run this command from the root of your Nova project folder."
    exit 1
fi

# Check if the input is a URL (GitHub raw or any web link)
if [[ "$INPUT" =~ ^https?:// ]]; then
    # Extract filename from URL
    FILENAME=$(basename "$INPUT")
    FILENAME="${FILENAME%%\?*}" # Remove query parameters if present
    
    echo "-> Downloading module from GitHub/URL..."
    curl -sSL "$INPUT" -o "modules/$FILENAME"
    
    if [ $? -ne 0 ]; then
        echo "Error: Failed to download module from $INPUT"
        exit 1
    fi
    echo "-> Downloaded $FILENAME into modules/"
else
    # Local file processing
    if [ ! -f "$INPUT" ]; then
        echo "Error: File '$INPUT' not found."
        exit 1
    fi
    FILENAME=$(basename "$INPUT")
    echo "-> Copying local file $INPUT to modules/..."
    cp "$INPUT" "modules/$FILENAME"
fi

echo "-> Recompiling Nova natively..."
gcc src/main.c src/environment.c src/registry.c modules/*.c -Iinclude -o nova

if [ $? -eq 0 ]; then
    echo "-> Updating global binary in /usr/local/bin/nova..."
    sudo mv nova /usr/local/bin/nova
    echo "Success! Module added and Nova recompiled successfully."
else
    echo "Error: Compilation failed."
    exit 1
fi
